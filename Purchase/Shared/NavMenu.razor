@using Purchase.Services
@inject SimpleAuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Purchase</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Главная
            </NavLink>
        </div>

        @if (isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="proposals">
                    <span class="oi oi-plus" aria-hidden="true"></span> Список заявок
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="proposal-material">
                    <span class="oi oi-list-rich" aria-hidden="true"></span> Позиции заявки
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="proposal-catalog">
                    <span class="oi oi-book" aria-hidden="true"></span> Справочник
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="simple-login">
                    <span class="oi oi-account-login" aria-hidden="true"></span> Вход в систему
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool isAuthenticated = false;
    private bool isInitialized = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            isInitialized = true;
            StateHasChanged();
            await Task.Delay(1); // Добавляем await для асинхронности
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}