@using Purchase.Services
@inject SimpleAuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Purchase</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Главная
            </NavLink>
        </div>

        @if (isAuthenticated)
        {
            <!-- Основные модули -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="proposals">
                    <span class="oi oi-plus" aria-hidden="true"></span> Список заявок
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="proposal-material">
                    <span class="oi oi-list-rich" aria-hidden="true"></span> Позиции заявки
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="proposal-catalog">
                    <span class="oi oi-book" aria-hidden="true"></span> Справочник
                </NavLink>
            </div>

            <!-- НОВЫЕ МОДУЛИ - ИНТЕГРАЦИЯ И СООТВЕТСТВИЕ -->
            <div class="nav-section-divider"></div>
            
            <div class="nav-section-header px-3">
                <small class="text-muted">ИНТЕГРАЦИЯ И АНАЛИТИКА</small>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="component-search">
                    <span class="oi oi-magnifying-glass" aria-hidden="true"></span> Поиск компонентов
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="compliance-check">
                    <span class="oi oi-task" aria-hidden="true"></span> Проверка
                </NavLink>
            </div>

           
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="simple-login">
                    <span class="oi oi-account-login" aria-hidden="true"></span> Вход в систему
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register">
                    <span class="oi oi-person" aria-hidden="true"></span> Регистрация
                </NavLink>
            </div>
        }
    </nav>
</div>

<style>
    .nav-section-divider {
        height: 1px;
        background-color: rgba(255,255,255,0.1);
        margin: 10px 15px;
    }

    .nav-section-header {
        padding-top: 15px;
        padding-bottom: 5px;
    }

    .nav-section-header small {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .nav-scrollable {
        height: calc(100vh - 60px);
        overflow-y: auto;
    }
</style>

@code {
    private bool collapseNavMenu = true;
    private bool isAuthenticated = false;
    private bool isInitialized = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            isInitialized = true;
            StateHasChanged();
            await Task.Delay(1);
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}