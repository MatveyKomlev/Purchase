@page "/proposal-material"
@page "/proposal-material/{ProposalId:int}"
@using Purchase.Data
@using Purchase.Services
@using Blazorise
@using Blazorise.DataGrid
@using Microsoft.JSInterop
@inject IProposalMaterialService MaterialService
@inject IProposalCatalogService CatalogService
@inject IProposalService ProposalService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Позиции заявки</PageTitle>

<Bar Breakpoint="Breakpoint.Desktop" Background="Background.Light" ThemeContrast="ThemeContrast.Light">
    <BarBrand>Позиции заявки №@proposal?.Number</BarBrand>
    <BarMenu>
        <BarStart>
            <BarItem>
                <Button Color="Color.Secondary" Clicked="@(() => GoBack())">
                    ↩️ Назад к заявкам
                </Button>
            </BarItem>
        </BarStart>
        <BarEnd>
            <BarItem>
                <Button Color="Color.Primary" Clicked="@(() => ShowCreateModal())">
                    ➕ Добавить позицию
                </Button>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

<!-- Информация о заявке -->
@if (proposal != null)
{
    <Card Class="mt-3">
        <CardBody>
            <div class="row">
                <div class="col-md-4">
                    <strong>Заявка:</strong> @proposal.Number
                </div>
                <div class="col-md-4">
                    <strong>Автор:</strong> @proposal.Author
                </div>
                <div class="col-md-4">
                    <strong>Статус:</strong> 
                    <Badge Color="@GetProposalStatusColor(proposal.Status)" Class="ms-1">
                        @proposal.Status.GetName()
                    </Badge>
                </div>
            </div>
        </CardBody>
    </Card>
}

<!-- Статистика по заявке -->
<Card Class="mt-3">
    <CardBody>
        <div class="row text-center">
            <div class="col">
                <h5 class="text-primary">@totalPositions</h5>
                <small class="text-muted">Всего позиций</small>
            </div>
            <div class="col">
                <h5 class="text-success">@totalQuantity.ToString("N0")</h5>
                <small class="text-muted">Общее количество</small>
            </div>
            <div class="col">
                <h5 class="text-warning">@totalEstimatedPrice.ToString("C0")</h5>
                <small class="text-muted">Ориентировочная сумма</small>
            </div>
            <div class="col">
                <h5 class="text-info">@averagePrice.ToString("C0")</h5>
                <small class="text-muted">Средняя цена</small>
            </div>
        </div>
    </CardBody>
</Card>

@if (isLoading)
{
    <Card Class="mt-3">
        <CardBody Class="text-center">
            <Spinner Color="Color.Primary" />
            <span class="ms-2">Загрузка материалов...</span>
        </CardBody>
    </Card>
}
else if (!materials.Any())
{
    <Card Class="mt-3">
        <CardBody Class="text-center">
            <Icon Name="IconName.Inbox" Size="IconSize.ExtraLarge" Class="text-muted mb-3" />
            <h5>Позиции не найдены</h5>
            <p class="text-muted">Добавьте первую позицию к заявке</p>
            <Button Color="Color.Primary" Clicked="@(() => ShowCreateModal())">
                ➕ Добавить позицию
            </Button>
        </CardBody>
    </Card>
}
else
{
    <Card Class="mt-3">
        <CardBody>
            <DataGrid TItem="ProposalMaterial"
                      Data="@materials"
                      @ref="dataGrid"
                      Editable="false"
                      ShowPager="true"
                      PageSize="10"
                      Responsive="true"
                      Class="table-striped">
                <DataGridColumns>
                    <DataGridColumn TItem="ProposalMaterial" Field="@nameof(ProposalMaterial.NameMaterial)" Caption="Материал" Sortable="true" Filterable="true" />
                    <DataGridColumn TItem="ProposalMaterial" Field="@nameof(ProposalMaterial.CategoryMaterial)" Caption="Категория" Sortable="true" Filterable="true" />
                    <DataGridColumn TItem="ProposalMaterial" Field="@nameof(ProposalMaterial.Code)" Caption="Код" Sortable="true" Width="120px" />
                    
                    <DataGridColumn TItem="ProposalMaterial" Field="@nameof(ProposalMaterial.Quantity)" Caption="Кол-во" Sortable="true" TextAlignment="TextAlignment.Center" Width="130px">
                        <DisplayTemplate>
                            <Badge Color="Color.Info" Outline="true">
                                @context.Quantity.ToString("N0") @context.UnitOfMeasure
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalMaterial" Field="@nameof(ProposalMaterial.EstimatedPrice)" Caption="Цена за ед." Sortable="true" TextAlignment="TextAlignment.End" Width="150px">
                        <DisplayTemplate>
                            @context.EstimatedPrice.ToString("C0")
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalMaterial" Field="@nameof(ProposalMaterial.TotalPrice)" Caption="Сумма" Sortable="true" TextAlignment="TextAlignment.End" Width="150px">
                        <DisplayTemplate>
                            <strong class="text-success">@context.TotalPrice.ToString("C0")</strong>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalMaterial" Field="@nameof(ProposalMaterial.StatusM)" Caption="Статус" Sortable="true" Width="140px">
                        <DisplayTemplate>
                            <Badge Color="@GetMaterialStatusColor(context.StatusM)" Class="text-uppercase">
                                @context.StatusM.GetName()
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalMaterial" Caption="Производитель" Sortable="true" Filterable="true">
                        <DisplayTemplate>
                            @if (!string.IsNullOrEmpty(context.ManufacturerName))
                            {
                                <div>
                                    <strong>@context.ManufacturerName</strong>
                                    @if (!string.IsNullOrEmpty(context.ManufacturerPartNumber))
                                    {
                                        <br />
                                        <small class="text-muted">@context.ManufacturerPartNumber</small>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalMaterial" TextAlignment="TextAlignment.Center" Filterable="false" Sortable="false" Caption="Действия" Width="180px">
                        <DisplayTemplate>
                            @{
                                var material = (ProposalMaterial)context;
                            }
                            <ButtonGroup Size="Size.Small">
                                <Button Color="Color.Warning"
                                        Size="Size.Small"
                                        Clicked="@(async () => await ShowEditModal(material))"
                                        Title="Редактировать">
                                    ✏️
                                </Button>
                                <Button Color="Color.Danger"
                                        Size="Size.Small"
                                        Clicked="@(async () => await DeleteItem(material.ID))"
                                        Title="Удалить">
                                    🗑️
                                </Button>
                            </ButtonGroup>
                        </DisplayTemplate>
                    </DataGridColumn>
                </DataGridColumns>
            </DataGrid>
        </CardBody>
    </Card>
}

<!-- Модальное окно создания/редактирования позиции -->
<Modal @bind-Visible="isModalVisible" Size="ModalSize.Large">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@(isEdit ? "Редактировать позицию" : "Добавить позицию")</ModalTitle>
            <Button CloseButton Clicked="@(() => CloseModal())" />
        </ModalHeader>
        <ModalBody>
            <Validations @ref="validations" Model="@materialModel" ValidateOnLoad="false">
                <!-- Выбор из каталога -->
                <Field>
                    <FieldLabel>Выбрать из каталога (автозаполнение)</FieldLabel>
                    <Select TValue="int?" @bind-SelectedValue="@selectedCatalogId">
                        <SelectedValueChanged>
                            @OnCatalogSelected
                        </SelectedValueChanged>
                        <SelectItem Value="@((int?)null)">-- Выберите из каталога --</SelectItem>
                        @foreach (var item in catalogItems)
                        {
                            <SelectItem Value="@item.ID">
                                @item.Material - @item.Category (@item.Price.ToString("C0"))
                            </SelectItem>
                        }
                    </Select>
                    <HelpText>Все поля заполнятся автоматически. Можно редактировать.</HelpText>
                </Field>

                <Divider />
                
                <!-- Основная информация -->
                <div class="row">
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Материал *</FieldLabel>
                            <TextEdit @bind-Text="@materialModel.NameMaterial" 
                                     Placeholder="Название материала">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </div>
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Категория *</FieldLabel>
                            <TextEdit @bind-Text="@materialModel.CategoryMaterial" 
                                     Placeholder="Категория материала">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <Field>
                            <FieldLabel>Код</FieldLabel>
                            <TextEdit @bind-Text="@materialModel.Code" 
                                     Placeholder="Внутренний код" />
                        </Field>
                    </div>
                    <div class="col-md-4">
                        <Field>
                            <FieldLabel>Количество *</FieldLabel>
                            <NumericEdit TValue="int"
                                        @bind-Value="@materialModel.Quantity"
                                        Min="1">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </NumericEdit>
                        </Field>
                    </div>
                    <div class="col-md-4">
                        <Field>
                            <FieldLabel>Единица измерения</FieldLabel>
                            <TextEdit @bind-Text="@materialModel.UnitOfMeasure" 
                                     Placeholder="шт, кг, м и т.д." />
                        </Field>
                    </div>
                </div>

                <!-- Производитель и цена -->
                <div class="row">
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Производитель</FieldLabel>
                            <TextEdit @bind-Text="@materialModel.ManufacturerName" 
                                     Placeholder="Название производителя" />
                        </Field>
                    </div>
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Партномер</FieldLabel>
                            <TextEdit @bind-Text="@materialModel.ManufacturerPartNumber" 
                                     Placeholder="Партномер производителя" />
                        </Field>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Ориентировочная цена *</FieldLabel>
                            <NumericEdit TValue="int"
                                         @bind-Value="@materialModel.EstimatedPrice"
                                         Min="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </NumericEdit>
                        </Field>
                    </div>
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Статус позиции *</FieldLabel>
                            <Select TValue="MaterialStatus" @bind-SelectedValue="@materialModel.StatusM">
                                @foreach (var status in Enum.GetValues<MaterialStatus>())
                                {
                                    <SelectItem Value="@status">@status.GetName()</SelectItem>
                                }
                            </Select>
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </Field>
                    </div>
                </div>

                <Field>
                    <FieldLabel>Комментарий</FieldLabel>
                    <TextEdit @bind-Text="@materialModel.Comment" 
                             Placeholder="Дополнительная информация..." 
                             Multiline="true" 
                             Rows="3" />
                </Field>
            </Validations>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary" 
                    Clicked="@(async () => await SaveItem())"
                    Disabled="@isSaving">
                @if (isSaving)
                {
                    <Spinner Size="SpinnerSize.Small" />
                }
                💾 @(isEdit ? "Обновить" : "Создать")
            </Button>
            <Button Color="Color.Secondary" 
                    Clicked="@(() => CloseModal())"
                    Disabled="@isSaving">
                ❌ Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [Parameter]
    public int ProposalId { get; set; }

    private List<ProposalMaterial> materials = new();
    private List<ProposalCatalog> catalogItems = new();
    private Proposal? proposal;

    private ProposalMaterial materialModel = new();
    private int? selectedCatalogId;
    private bool isModalVisible = false;
    private bool isEdit = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private Validations? validations;
    private DataGrid<ProposalMaterial>? dataGrid;

    // Статистика
    private int totalPositions = 0;
    private int totalQuantity = 0;
    private int totalEstimatedPrice = 0;
    private int averagePrice = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ProposalId > 0)
            {
                await LoadData();
            }
            else
            {
                await ShowError("ID заявки не указан!");
                Navigation.NavigateTo("/proposals");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка инициализации: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProposalId > 0)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        try
        {
            var proposalExists = await MaterialService.ProposalExistsAsync(ProposalId);
            if (!proposalExists)
            {
                await ShowError($"Заявка с ID {ProposalId} не найдена!");
                Navigation.NavigateTo("/proposals");
                return;
            }

            await LoadProposal();
            await LoadCatalog();
            await LoadMaterials();
            CalculateStatistics();
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка загрузки данных: {ex.Message}");
        }
    }

    private async Task LoadProposal()
    {
        proposal = await ProposalService.GetByIdAsync(ProposalId);
        if (proposal == null)
        {
            await ShowError($"Заявка {ProposalId} не найдена в базе!");
        }
    }

    private async Task LoadMaterials()
    {
        materials = await MaterialService.GetByProposalIdAsync(ProposalId);
    }

    private async Task LoadCatalog()
    {
        catalogItems = await CatalogService.GetAllAsync();
    }

    private void CalculateStatistics()
    {
        totalPositions = materials.Count;
        totalQuantity = materials.Sum(m => m.Quantity);
        totalEstimatedPrice = materials.Sum(m => m.TotalPrice);
        averagePrice = totalPositions > 0 ? totalEstimatedPrice / totalPositions : 0;
    }

    private void ShowCreateModal()
    {
        materialModel = new ProposalMaterial
        {
            ProposalId = ProposalId,
            StatusM = MaterialStatus.New,
            UnitOfMeasure = "шт",
            Quantity = 1,
            EstimatedPrice = 0
        };
        selectedCatalogId = null;
        isEdit = false;
        isModalVisible = true;
        StateHasChanged();
    }

    private async Task ShowEditModal(ProposalMaterial item)
    {
        try
        {
            var material = await MaterialService.GetByIdAsync(item.ID);
            if (material != null)
            {
                materialModel = material;
                selectedCatalogId = material.CatalogId;
                isEdit = true;
                isModalVisible = true;
                StateHasChanged();
            }
            else
            {
                await ShowError("Материал не найден!");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка загрузки материала: {ex.Message}");
        }
    }

    private async Task SaveItem()
    {
        if (validations == null) return;

        try
        {
            isSaving = true;
            StateHasChanged();

            if (await validations.ValidateAll())
            {
                materialModel.ProposalId = ProposalId;

                if (isEdit)
                {
                    await MaterialService.UpdateAsync(materialModel);
                    await ShowSuccess("Позиция успешно обновлена!");
                }
                else
                {
                    await MaterialService.CreateAsync(materialModel);
                    await ShowSuccess("Позиция успешно создана!");
                }

                CloseModal();
                await LoadMaterials();
                CalculateStatistics();
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка сохранения: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteItem(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                "Вы уверены, что хотите удалить эту позицию?");
            
            if (confirmed)
            {
                await MaterialService.DeleteAsync(id);
                await ShowSuccess("Позиция успешно удалена!");
                await LoadMaterials();
                CalculateStatistics();
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка удаления: {ex.Message}");
        }
    }

    private void OnCatalogSelected(int? catalogId)
    {
        try
        {
            if (catalogId.HasValue)
            {
                var catalogItem = catalogItems.FirstOrDefault(c => c.ID == catalogId.Value);
                if (catalogItem != null)
                {
                    // Заполняем поля из каталога
                    materialModel.NameMaterial = catalogItem.Material;
                    materialModel.CategoryMaterial = catalogItem.Category;
                    materialModel.ManufacturerPartNumber = catalogItem.ManufacturerPartNumber;
                    materialModel.ManufacturerName = catalogItem.ManufacturerName;
                    materialModel.UnitOfMeasure = catalogItem.UnitOfMeasure;
                    materialModel.EstimatedPrice = catalogItem.Price;
                    materialModel.Code = catalogItem.ManufacturerPartNumber ?? $"CAT-{catalogItem.ID}";
                    materialModel.CatalogId = catalogId.Value;
                    materialModel.StatusM = MaterialStatus.InCatalog;

                    StateHasChanged();
                    _ = ShowInfo($"Материал '{catalogItem.Material}' загружен из каталога!");
                }
            }
            else
            {
                materialModel.CatalogId = null;
                materialModel.StatusM = MaterialStatus.New;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _ = ShowError($"Ошибка выбора из каталога: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        isModalVisible = false;
        isSaving = false;
        selectedCatalogId = null;
        validations?.ClearAll();
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/proposals");
    }

    private Color GetMaterialStatusColor(MaterialStatus status)
    {
        return status switch
        {
            MaterialStatus.New => Color.Info,
            MaterialStatus.InCatalog => Color.Success,
            MaterialStatus.Closed => Color.Secondary,
            _ => Color.Secondary
        };
    }

    private Color GetProposalStatusColor(ErpStatus status)
    {
        return status switch
        {
            ErpStatus.InProgress => Color.Warning,
            ErpStatus.Approved => Color.Success,
            ErpStatus.Rejected => Color.Danger,
            _ => Color.Secondary
        };
    }

    private async Task ShowSuccess(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"✅ {message}");
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"❌ {message}");
    }

    private async Task ShowInfo(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"ℹ️ {message}");
    }
}