@page "/compliance-check"
@inject ComplianceService ComplianceService
@using Microsoft.EntityFrameworkCore
@using Purchase.Data
@using Purchase.Services
@inject IDbContextFactory<PurchaseContext> ContextFactory

<PageTitle>Проверка соответствия</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2>✅ Проверка соответствия</h2>
            <p class="text-muted">Проверка компонентов на соответствие техническим регламентам и стандартам</p>
        </div>
    </div>

    <!-- Список компонентов -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Компоненты для проверки</h5>
                </div>
                <div class="card-body">
                    @if (components?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>LCSC код</th>
                                        <th>Производитель</th>
                                        <th>Локализация</th>
                                        <th>Статус</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var component in components)
                                    {
                                        <tr>
                                            <td>@component.ManufacturerPartNumber</td>
                                            <td>@component.Manufacturer</td>
                                            <td>
                                                <div class="progress" style="height: 10px; width: 100px;">
                                                    <div class="progress-bar @GetProgressBarClass(component.LocalizationPercent)" 
                                                         style="width: @component.LocalizationPercent%">
                                                    </div>
                                                </div>
                                                <small>@component.LocalizationPercent%</small>
                                            </td>
                                            <td>
                                                <ComplianceBadge Status="@component.ComplianceStatus" />
                                            </td>
                                            <td>
                                                <button @onclick="() => CheckCompliance(component.ID)" 
                                                        class="btn btn-sm btn-outline-primary"
                                                        disabled="@(checkInProgress == component.ID)">
                                                    @if (checkInProgress == component.ID)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                    }
                                                    Проверить
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <p>Нет компонентов для проверки</p>
                            <a href="/component-search" class="btn btn-primary">Найти компоненты</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Результаты проверки -->
    @if (checkResult != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">📊 Результаты проверки</h5>
                    </div>
                    <div class="card-body">
                        @if (checkResult.Success && checkResult.Component != null)
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Компонент: @checkResult.Component.ManufacturerPartNumber</h6>
                                    <p>Производитель: @checkResult.Component.Manufacturer</p>
                                    <ComplianceBadge Status="@checkResult.ComplianceStatus" />
                                </div>
                                <div class="col-md-6">
                                    <div class="alert alert-success">
                                        <strong>Результат:</strong> @checkResult.PassedChecks из @checkResult.TotalChecks проверок пройдено
                                    </div>
                                </div>
                            </div>

                            <h6 class="mt-3">Детали проверки:</h6>
                            @foreach (var check in checkResult.Checks)
                            {
                                <div class="card mb-2 @(check.Passed ? "border-success" : "border-danger")">
                                    <div class="card-body py-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@check.Name</strong>
                                                <br/>
                                                <small class="text-muted">@check.Description</small>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge @(check.Passed ? "bg-success" : "bg-danger")">
                                                    @(check.Passed ? "✅" : "❌")
                                                </span>
                                                <br/>
                                                <small>Требуется: @check.RequiredValue</small>
                                                <br/>
                                                <small>Факт: @check.ActualValue</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-danger">
                                <h6>❌ Ошибка проверки</h6>
                                <p>@checkResult.ErrorMessage</p>
                            </div>
                        }

                        <div class="mt-3">
                            <button @onclick="CloseResults" class="btn btn-outline-secondary">
                                Закрыть
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ElectronicComponent>? components;
    private ComplianceCheckResult? checkResult;
    private int? checkInProgress = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadComponents();
    }

    private async Task LoadComponents()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        components = await context.ElectronicComponents
            .OrderByDescending(ec => ec.CreatedAt)
            .ToListAsync();
    }

    private async Task CheckCompliance(int componentId)
    {
        checkInProgress = componentId;
        StateHasChanged();

        checkResult = await ComplianceService.CheckComplianceAsync(componentId);
        
        checkInProgress = null;
        await LoadComponents(); // Обновляем список
        StateHasChanged();
    }

    private void CloseResults()
    {
        checkResult = null;
        StateHasChanged();
    }

    private string GetProgressBarClass(int percent)
    {
        return percent >= 60 ? "bg-success" : 
               percent >= 30 ? "bg-warning" : "bg-danger";
    }
}