@page "/simple-login"
@inject SimpleAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Вход</PageTitle>

<div style="max-width: 300px; margin: 100px auto; text-align: center;">
    <h2>Вход в систему</h2>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="color: red; background: #ffe6e6; padding: 10px; margin: 10px 0;">
            @errorMessage
        </div>
    }

    <form>
        <div style="margin: 20px 0;">
            <input @bind="username" placeholder="Логин" style="padding: 10px; width: 100%; margin: 5px 0;" />
            <br />
            <input @bind="password" type="password" placeholder="Пароль" style="padding: 10px; width: 100%; margin: 5px 0;" />
        </div>

        <button @onclick="HandleLogin" type="button" style="padding: 10px 20px; background: blue; color: white; border: none;">
            Войти
        </button>
    </form>

    <div style="margin-top: 30px; font-size: 12px; color: #666;">
        Тестовые данные:<br />
        Логин: <strong>admin</strong><br />
        Пароль: <strong>admin123</strong>
    </div>
</div>

@code {
    private string username = "admin";
    private string password = "admin123";
    private string errorMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("console.log", "🔄 Login component rendered");
        }
    }

    private async Task HandleLogin()
    {
        await JSRuntime.InvokeVoidAsync("console.log", "🔄 Попытка входа...", username);

        try
        {
            errorMessage = "";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("console.log", "🔐 Вызов AuthService.LoginAsync...");
            var success = await AuthService.LoginAsync(username, password);
            await JSRuntime.InvokeVoidAsync("console.log", "📋 Результат AuthService:", success);

            if (success)
            {
                await JSRuntime.InvokeVoidAsync("console.log", "✅ Вход успешен!");
                ((SimpleAuthStateProvider)AuthStateProvider).NotifyAuthenticationStateChanged();
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Ошибка входа! Проверьте логин и пароль.";
                await JSRuntime.InvokeVoidAsync("console.log", "❌ Ошибка входа");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
            await JSRuntime.InvokeVoidAsync("console.log", "💥 Ошибка входа:", ex);
        }

        StateHasChanged();
    }
}