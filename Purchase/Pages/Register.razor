@page "/register"
@inject SimpleAuthService AuthService
@using Microsoft.EntityFrameworkCore
@using Purchase.Data
@using Purchase.Services
@inject IDbContextFactory<PurchaseContext> ContextFactory
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Регистрация - Purchase</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Регистрация в системе</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">
                            @successMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="@newUser" OnValidSubmit="@HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="username" class="form-label">Логин *</label>
                            <InputText id="username" @bind-Value="@newUser.Username" class="form-control" />
                            <ValidationMessage For="@(() => newUser.Username)" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Пароль *</label>
                            <InputText id="password" @bind-Value="@newUser.Password" type="password" class="form-control" />
                            <ValidationMessage For="@(() => newUser.Password)" />
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Подтверждение пароля *</label>
                            <InputText id="confirmPassword" @bind-Value="@confirmPassword" type="password" class="form-control" />
                            @if (!string.IsNullOrEmpty(passwordError))
                            {
                                <div class="text-danger small">@passwordError</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="fullName" class="form-label">ФИО *</label>
                            <InputText id="fullName" @bind-Value="@newUser.FullName" class="form-control" />
                            <ValidationMessage For="@(() => newUser.FullName)" />
                        </div>

                        <div class="mb-3">
                            <label for="department" class="form-label">Отдел *</label>
                            <InputText id="department" @bind-Value="@newUser.Department" class="form-control" />
                            <ValidationMessage For="@(() => newUser.Department)" />
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <InputText id="email" @bind-Value="@newUser.Email" class="form-control" />
                            <ValidationMessage For="@(() => newUser.Email)" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Зарегистрироваться
                            </button>
                            <a href="/simple-login" class="btn btn-outline-secondary">Уже есть аккаунт? Войти</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel newUser = new();
    private string confirmPassword = "";
    private string errorMessage = "";
    private string successMessage = "";
    private string passwordError = "";
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        errorMessage = "";
        successMessage = "";
        passwordError = "";
        isLoading = true;

        // Проверка совпадения паролей
        if (newUser.Password != confirmPassword)
        {
            passwordError = "Пароли не совпадают";
            isLoading = false;
            StateHasChanged();
            return;
        }

        // Проверка сложности пароля
        if (newUser.Password.Length < 6)
        {
            passwordError = "Пароль должен содержать минимум 6 символов";
            isLoading = false;
            StateHasChanged();
            return;
        }

        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();

            // Проверка уникальности логина
            var existingUser = await context.Users
                .FirstOrDefaultAsync(u => u.Username == newUser.Username);

            if (existingUser != null)
            {
                errorMessage = "Пользователь с таким логином уже существует";
                isLoading = false;
                StateHasChanged();
                return;
            }

            var user = new User
            {
                Username = newUser.Username,
                FullName = newUser.FullName ?? "Тестовый пользователь",
                Department = newUser.Department ?? "Тестовый отдел",
                Email = newUser.Email ?? "",
                Role = UserRole.User,
                IsActive = true,
                CreatedAt = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("Russian Standard Time")),
                PasswordHash = newUser.Password,
                PasswordSalt = "temp_salt"
            };

            context.Users.Add(user);
            await context.SaveChangesAsync();

            successMessage = "Регистрация успешна! Теперь вы можете войти в систему.";

            // Очищаем форму
            newUser = new();
            confirmPassword = "";
        }
        catch (Exception ex)
        {
            // Подробная информация об ошибке
            var errorDetails = $"Ошибка при регистрации: {ex.Message}";

            if (ex.InnerException != null)
            {
                errorDetails += $"\nВнутренняя ошибка: {ex.InnerException.Message}";

                if (ex.InnerException.InnerException != null)
                {
                    errorDetails += $"\nДетали: {ex.InnerException.InnerException.Message}";
                }
            }

            errorMessage = errorDetails;

            // Логируем в консоль для отладки
            try
            {
                await JSRuntime.InvokeVoidAsync("console.log", "💥 Registration error:", errorDetails);
            }
            catch { }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class RegisterModel
    {
        [Required(ErrorMessage = "Логин обязателен")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Логин должен быть от 3 до 50 символов")]
        [RegularExpression(@"^[a-zA-Z0-9_]+$", ErrorMessage = "Логин может содержать только буквы, цифры и подчеркивание")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Пароль обязателен")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Пароль должен быть от 6 до 100 символов")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Подтверждение пароля обязательно")]
        [Compare("Password", ErrorMessage = "Пароли не совпадают")]
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = "";

        [Required(ErrorMessage = "ФИО обязательно")]
        [StringLength(100, ErrorMessage = "ФИО не должно превышать 100 символов")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Отдел обязателен")]
        [StringLength(100, ErrorMessage = "Название отдела не должно превышать 100 символов")]
        public string Department { get; set; } = "";

        [EmailAddress(ErrorMessage = "Некорректный формат email")]
        [StringLength(100, ErrorMessage = "Email не должен превышать 100 символов")]
        public string Email { get; set; } = "";
    }
}