@page "/proposals"
@using Purchase.Data
@using Purchase.Services
@using Blazorise.DataGrid
@using Blazorise
@using Blazorise.Icons
@using Microsoft.JSInterop
@inject IProposalService PurchaseService
@inject SimpleAuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Заявки на закупку</PageTitle>

<h1>Заявки на закупку</h1>

<Bar Breakpoint="Breakpoint.Desktop"
     Background="Background.Light"
     ThemeContrast="ThemeContrast.Light">
    <BarBrand>Управление заявками</BarBrand>
    <BarMenu>
        <BarEnd>
            <BarItem>
                <Button Color="Color.Primary" Clicked="@ShowCreateModal">Создать заявку</Button>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

<Card>
    <CardBody>
        @if (isLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
                <span class="ms-2">Загрузка заявок...</span>
            </div>
        }
        else if (!proposals.Any())
        {
            <div class="text-center p-4">
                <div class="text-muted mb-3" style="font-size: 3rem;">📋</div>
                <h5>Заявки не найдены</h5>
                <p class="text-muted">Создайте первую заявку на закупку</p>
                <Button Color="Color.Primary" Clicked="@ShowCreateModal">Создать заявку</Button>
            </div>
        }
        else
        {
            <DataGrid TItem="Proposal"
                      Data="@proposals"
                      @ref="dataGrid"
                      Editable="false"
                      ShowPager="true"
                      PageSize="10"
                      TotalItems="@proposals.Count"
                      Responsive="true"
                      Class="table-striped">

                <DataGridColumns>
                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.ID)" 
                                    Caption="ID" 
                                    Sortable="true"
                                    Width="80px" />

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.Number)" 
                                    Caption="Номер заявки" 
                                    Sortable="true"
                                    Filterable="true">
                        <DisplayTemplate>
                            <strong>@context.Number</strong>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.DateCreation)" 
                                    Caption="Дата создания" 
                                    Sortable="true"
                                    Width="140px">
                        <DisplayTemplate>
                            @context.DateCreation.ToString("dd.MM.yyyy")
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.Author)" 
                                    Caption="Автор" 
                                    Sortable="true"
                                    Filterable="true" />

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.Department)" 
                                    Caption="Отдел" 
                                    Sortable="true"
                                    Filterable="true" />

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.Priority)" 
                                    Caption="Приоритет" 
                                    Sortable="true"
                                    Width="140px">
                        <DisplayTemplate>
                            <Badge Color="@GetPriorityColor(context.Priority)" 
                                   Class="text-uppercase w-100 text-center">
                                @GetPriorityName(context.Priority)
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.Status)" 
                                    Caption="Статус" 
                                    Sortable="true"
                                    Width="150px">
                        <DisplayTemplate>
                            <Badge Color="@GetStatusColor(context.Status)" 
                                   Class="text-uppercase w-100 text-center">
                                @context.Status.GetName()
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.Deadline)" 
                                    Caption="Срок поставки" 
                                    Sortable="true"
                                    Width="160px">
                        <DisplayTemplate>
                            @if (context.Deadline.HasValue)
                            {
                                <div class="d-flex align-items-center">
                                    <span>@context.Deadline.Value.ToString("dd.MM.yyyy")</span>
                                    @if (context.Deadline.Value < DateTime.Now && context.Status != ErpStatus.Approved)
                                    {
                                        <Badge Color="Color.Danger" Class="ms-1" Title="Просрочено">!</Badge>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="Proposal" 
                                    Field="@nameof(Proposal.PositionsCount)" 
                                    Caption="Позиций" 
                                    Sortable="true" 
                                    TextAlignment="TextAlignment.Center"
                                    Width="100px">
                        <DisplayTemplate>
                            <Badge Color="Color.Info" Outline="true">
                                @context.PositionsCount
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TextAlignment="TextAlignment.Center" 
                                    Filterable="false" 
                                    Sortable="false" 
                                    Caption="Действия"
                                    Width="200px">
                        <DisplayTemplate>
                            @{
                                var proposal = (Proposal)context;
                                var canEdit = proposal.Status != ErpStatus.Approved;
                            }
                            <div class="btn-group btn-group-sm">
                                <Button Color="Color.Success" 
                                        Size="Size.Small"
                                        Clicked="@(async () => await ViewProposalMaterials(proposal.ID))"
                                        Title="Материалы заявки">
                                    📦
                                </Button>
                        
                                <Button Color="Color.Info" 
                                        Size="Size.Small"
                                        Clicked="@(async () => await ViewProposal(proposal.ID))"
                                        Title="Просмотр заявки">
                                    👁️
                                </Button>
                        
                                @if (canEdit)
                                {
                                    <Button Color="Color.Warning"
                                            Size="Size.Small"
                                            Clicked="@(async () => await ShowEditModal(proposal))"
                                            Title="Редактировать заявку">
                                        ✏️
                                    </Button>
                            
                                    <Button Color="Color.Danger"
                                            Size="Size.Small"
                                            Clicked="@(async () => await DeleteProposal(proposal.ID))"
                                            Title="Удалить заявку">
                                        🗑️
                                    </Button>
                                }
                            </div>
                        </DisplayTemplate>
                    </DataGridColumn>
                </DataGridColumns>
            </DataGrid>
        }
    </CardBody>
</Card>

<!-- Модальное окно создания/редактирования -->
<Modal @bind-Visible="isModalVisible" Size="ModalSize.Large">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@(isEdit ? "Редактировать заявку" : "Создать заявку")</ModalTitle>
            <Button Close Clicked="@CloseModal" />
        </ModalHeader>
        <ModalBody>
            <Validations @ref="validations" Model="@proposalModel" ValidateOnLoad="false">
                <Field>
                    <FieldLabel>Номер заявки *</FieldLabel>
                    <TextEdit @bind-Text="@proposalModel.Number" 
                             Placeholder="Введите номер заявки"
                             Disabled="@isEdit">
                        <Feedback>
                            <ValidationError />
                        </Feedback>
                    </TextEdit>
                </Field>

                <Field>
                    <FieldLabel>Автор *</FieldLabel>
                    <TextEdit @bind-Text="@proposalModel.Author" 
                             Placeholder="Введите автора">
                        <Feedback>
                            <ValidationError />
                        </Feedback>
                    </TextEdit>
                </Field>

                <Field>
                    <FieldLabel>Отдел *</FieldLabel>
                    <TextEdit @bind-Text="@proposalModel.Department" 
                             Placeholder="Введите отдел">
                        <Feedback>
                            <ValidationError />
                        </Feedback>
                    </TextEdit>
                </Field>

                <div class="row">
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Приоритет *</FieldLabel>
                            <Select TValue="Priorities" @bind-SelectedValue="@proposalModel.Priority">
                                <SelectItem Value="@Priorities.Low">@GetPriorityName(Priorities.Low)</SelectItem>
                                <SelectItem Value="@Priorities.Medium">@GetPriorityName(Priorities.Medium)</SelectItem>
                                <SelectItem Value="@Priorities.High">@GetPriorityName(Priorities.High)</SelectItem>
                                <SelectItem Value="@Priorities.Critical">@GetPriorityName(Priorities.Critical)</SelectItem>
                            </Select>
                        </Field>
                    </div>

                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Статус *</FieldLabel>
                            <Select TValue="ErpStatus" @bind-SelectedValue="@proposalModel.Status">
                                @foreach (var status in Enum.GetValues<ErpStatus>())
                                {
                                    <SelectItem Value="@status">@status.GetName()</SelectItem>
                                }
                            </Select>
                        </Field>
                    </div>
                </div>

                <Field>
                    <FieldLabel>Срок поставки</FieldLabel>
                    <DateEdit @bind-Date="@proposalModel.Deadline" 
                             Placeholder="Выберите дату..." />
                </Field>

                <Field>
                    <FieldLabel>Обоснование закупки</FieldLabel>
                    <TextEdit @bind-Text="@proposalModel.Explanation" 
                             Placeholder="Опишите для чего нужна эта закупка..." 
                             Multiline="true" 
                             Rows="4" />
                    <small class="form-text text-muted">Максимум 500 символов</small>
                </Field>
            </Validations>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary" 
                    Clicked="@SaveProposal"
                    Disabled="@isSaving">
                @if (isSaving)
                {
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                }
                @(isEdit ? "Обновить" : "Создать")
            </Button>
            <Button Color="Color.Secondary" 
                    Clicked="@CloseModal"
                    Disabled="@isSaving">
                Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private List<Proposal> proposals = new();
    private Proposal proposalModel = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isModalVisible = false;
    private bool isEdit = false;
    private Validations? validations;
    private DataGrid<Proposal>? dataGrid;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isAuth = await AuthService.IsAuthenticatedAsync();
            if (!isAuth)
            {
                NavigationManager.NavigateTo("/simple-login");
                return;
            }

            await LoadProposals();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки: {ex.Message}";
            Console.WriteLine($"❌ Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(errorMessage))
        {
            await ShowError(errorMessage);
            errorMessage = "";
        }
    }

    private async Task LoadProposals()
    {
        proposals = await PurchaseService.GetAllProposalsAsync();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        try
        {
            proposalModel = new Proposal
            {
                DateCreation = DateTime.Now,
                Status = ErpStatus.InProgress,
                Priority = Priorities.Medium
            };
            isEdit = false;
            isModalVisible = true;
            
            _ = GenerateProposalNumberAsync();
        }
        catch (Exception ex)
        {
            _ = ShowError($"Ошибка создания формы: {ex.Message}");
        }
    }

    private async Task ShowEditModal(Proposal proposal)
    {
        try
        {
            var result = await PurchaseService.GetByIdAsync(proposal.ID);
            if (result != null)
            {
                proposalModel = result;
                isEdit = true;
                isModalVisible = true;
                StateHasChanged();
            }
            else
            {
                await ShowError("Заявка не найдена");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка загрузки заявки: {ex.Message}");
        }
    }

    private async Task GenerateProposalNumberAsync()
    {
        try
        {
            proposalModel.Number = await PurchaseService.GenerateProposalNumberAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка генерации номера: {ex.Message}");
        }
    }

   private async Task SaveProposal()
{
    if (validations == null) return;

    try
    {
        isSaving = true;
        StateHasChanged();

        if (await validations.ValidateAll())
        {

            var userId = await AuthService.GetUserIdAsync();
            
            if (isEdit)
            {
                await PurchaseService.UpdateAsync(proposalModel);
                await ShowSuccess("Заявка успешно обновлена");
            }
            else
            {
        
                await PurchaseService.CreateAsync(proposalModel, userId);
                await ShowSuccess("Заявка успешно создана");
            }
        }
    }
    catch (Exception ex)
    {
        await ShowError($"Ошибка сохранения: {ex.Message}");
    }
    finally
    {
        isSaving = false;
        StateHasChanged();
    }
}

    private async Task DeleteProposal(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                "Вы уверены, что хотите удалить эту заявку? Это действие нельзя отменить.");
            
            if (confirmed)
            {
                await PurchaseService.DeleteAsync(id);
                await ShowSuccess("Заявка успешно удалена");
                await LoadProposals();
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка удаления: {ex.Message}");
        }
    }

    private Task ViewProposal(int id)
    {
        NavigationManager.NavigateTo($"/proposal-view/{id}");
        return Task.CompletedTask;
    }

    private Task ViewProposalMaterials(int proposalId)
    {
        NavigationManager.NavigateTo($"/proposal-material/{proposalId}");
        return Task.CompletedTask;
    }

    private void CloseModal()
    {
        isModalVisible = false;
        isSaving = false;
        validations?.ClearAll();
        StateHasChanged();
    }

    private Color GetStatusColor(ErpStatus status)
    {
        return status switch
        {
            ErpStatus.InProgress => Color.Warning,
            ErpStatus.Approved => Color.Success,
            ErpStatus.Rejected => Color.Danger,
            _ => Color.Secondary
        };
    }

    private Color GetPriorityColor(Priorities priority)
    {
        return priority switch
        {
            Priorities.Low => Color.Success,
            Priorities.Medium => Color.Warning,
            Priorities.High => Color.Danger,
            Priorities.Critical => Color.Dark,
            _ => Color.Secondary
        };
    }

    private string GetPriorityName(Priorities priority)
    {
        return priority switch
        {
            Priorities.Low => "Низкий",
            Priorities.Medium => "Средний", 
            Priorities.High => "Высокий",
            Priorities.Critical => "Критический",
            _ => priority.ToString()
        };
    }

    private async Task ShowSuccess(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"✅ {message}");
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"❌ {message}");
    }
}