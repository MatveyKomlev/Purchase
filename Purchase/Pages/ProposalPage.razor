@page "/proposals"
@using Purchase.Data
@using Purchase.Services
@using Blazorise.DataGrid
@using Blazorise
@using Blazorise.Icons
@using Microsoft.JSInterop
@inject IProposalService PurchaseService

<PageTitle>Заявки на закупку</PageTitle>

<h1>Заявки на закупку</h1>

<Bar Breakpoint="Breakpoint.Desktop"
     Background="Background.Light"
     ThemeContrast="ThemeContrast.Light">
    <BarBrand>Управление заявками</BarBrand>
    <BarMenu>
        <BarEnd>
            <BarItem>
                <Button Color="Color.Primary" Clicked="ShowCreateModal">Создать заявку</Button>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

<DataGrid TItem="Proposal"
          Data="proposals"
          @ref="dataGrid"
          Editable="false"
          ShowPager="true"
          PageSize="10">
    <DataGridColumns>
        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.ID)" Caption="ID" Sortable="true" />
        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.Number)" Caption="Номер заявки" Sortable="true" />
        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.DateCreation)" Caption="Дата создания" Sortable="true" />
        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.Author)" Caption="Автор" Sortable="true" />
        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.Department)" Caption="Отдел" Sortable="true" />
        
        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.Priority)" Caption="Приоритет" Sortable="true">
            <DisplayTemplate>
                <Badge Color="@GetPriorityColor(context.Priority)" Class="text-uppercase">
                    @GetPriorityName(context.Priority)
                </Badge>
            </DisplayTemplate>
        </DataGridColumn>

        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.Status)" Caption="Статус" Sortable="true">
            <DisplayTemplate>
                <Badge Color="@GetStatusColor(context.Status)" Class="text-uppercase">
                    @context.Status.GetName()
                </Badge>
            </DisplayTemplate>
        </DataGridColumn>

        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.Deadline)" Caption="Срок поставки" Sortable="true">
            <DisplayTemplate>
                @if (context.Deadline.HasValue)
                {
                    @context.Deadline.Value.ToShortDateString()
                    
                    @if (context.Deadline.Value < DateTime.Now && context.Status != ErpStatus.Approved)
                    {
                        <Badge Color="Color.Danger" Class="ms-1">Просрочен</Badge>
                    }
                }
                else
                {
                    <span class="text-muted">Не указан</span>
                }
            </DisplayTemplate>
        </DataGridColumn>

        <DataGridColumn TItem="Proposal" Field="@nameof(Proposal.PositionsCount)" Caption="Позиций" Sortable="true" TextAlignment="TextAlignment.Center">
            <DisplayTemplate>
                <Badge Color="Color.Info">
                    @context.PositionsCount
                </Badge>
            </DisplayTemplate>
        </DataGridColumn>

                <DataGridColumn TextAlignment="TextAlignment.Center" Filterable="false" Sortable="false" Caption="Действия">
            <DisplayTemplate>
                @{
                    var proposal = (Proposal)context;
                    var canEdit = proposal.Status != ErpStatus.Approved;
                }
                <div class="mt-3 p-3 bg-light">
                    <h5>Отладка - существующие заявки:</h5>
                    @foreach (var p in proposals.Take(5))
                    {
                        <div class="mb-1">
                            <span>ID: @p.ID, Номер: @p.Number, Автор: @p.Author</span>
                            <Button Color="Color.Success" Size="Size.Small"
                                    Clicked="@(() => ViewProposalMaterials(p.ID))"
                                    Class="ms-2">
                                📦 Перейти (ID=@p.ID)
                            </Button>
                        </div>
                    }
                </div>
                <ButtonGroup Size="Size.Small">
                    <Button Color="Color.Success" 
                            Size="Size.Small"
                            Clicked="@(() => ViewProposalMaterials(proposal.ID))"
                            Title="Материалы заявки">
                        📦
                    </Button>
            
                    <Button Color="Color.Info" 
                            Size="Size.Small"
                            Clicked="@(() => ViewProposal(proposal.ID))"
                            Title="Просмотр">
                        👁️
                    </Button>
            
                    <Button Color="Color.Warning"
                            Size="Size.Small"
                            Hidden="@(!canEdit)"
                            Clicked="@(() => ShowEditModal(proposal))"
                            Title="Редактировать">
                        ✏️
                    </Button>
            
                    <Button Color="Color.Danger"
                            Size="Size.Small"
                            Hidden="@(!canEdit)"
                            Clicked="@(() => DeleteProposal(proposal.ID))"
                            Title="Удалить">
                        🗑️
                    </Button>
                </ButtonGroup>
            </DisplayTemplate>
        </DataGridColumn>
    </DataGridColumns>
</DataGrid>

<!-- Модальное окно создания/редактирования -->
<Modal @bind-Visible="isModalVisible" Size="ModalSize.Large">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@(isEdit ? "Редактировать заявку" : "Создать заявку")</ModalTitle>
            <Button CloseButton Clicked="CloseModal" />
        </ModalHeader>
        <ModalBody>
            <Validations @ref="validations">
                <Field>
                    <FieldLabel>Номер заявки *</FieldLabel>
                    <TextEdit @bind-Text="proposalModel.Number" Placeholder="Введите номер заявки" />
                    <ValidationError>Номер заявки обязателен</ValidationError>
                </Field>

                <Field>
                    <FieldLabel>Автор *</FieldLabel>
                    <TextEdit @bind-Text="proposalModel.Author" Placeholder="Введите автора" />
                    <ValidationError>Автор обязателен</ValidationError>
                </Field>

                <Field>
                    <FieldLabel>Отдел *</FieldLabel>
                    <TextEdit @bind-Text="proposalModel.Department" Placeholder="Введите отдел" />
                    <ValidationError>Отдел обязателен</ValidationError>
                </Field>

                <Field>
                    <FieldLabel>Приоритет *</FieldLabel>
                    <Select TValue="Priorities" @bind-SelectedValue="proposalModel.Priority">
                        <SelectItem Value="@Priorities.Low">@GetPriorityName(Priorities.Low)</SelectItem>
                        <SelectItem Value="@Priorities.Medium">@GetPriorityName(Priorities.Medium)</SelectItem>
                        <SelectItem Value="@Priorities.High">@GetPriorityName(Priorities.High)</SelectItem>
                        <SelectItem Value="@Priorities.Critical">@GetPriorityName(Priorities.Critical)</SelectItem>
                    </Select>
                </Field>

                <Field>
                    <FieldLabel>Статус *</FieldLabel>
                    <Select TValue="ErpStatus" @bind-SelectedValue="proposalModel.Status">
                        @foreach (var status in Enum.GetValues<ErpStatus>())
                        {
                            <SelectItem Value="@status">@status.GetName()</SelectItem>
                        }
                    </Select>
                </Field>

                <Field>
                    <FieldLabel>Срок поставки</FieldLabel>
                    <DateEdit @bind-Date="proposalModel.Deadline" />
                </Field>

                <Field>
                    <FieldLabel>Обоснование закупки</FieldLabel>
                    <TextEdit @bind-Text="proposalModel.Explanation" 
                             Placeholder="Опишите для чего нужна эта закупка..." 
                             Multiline="true" 
                             Rows="3" />
                </Field>
            </Validations>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary" Clicked="SaveProposal">
                💾
                @(isEdit ? "Обновить" : "Создать")
            </Button>
            <Button Color="Color.Secondary" Clicked="CloseModal">
                ❌
                Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private List<Proposal> proposals = new();
    private Proposal proposalModel = new();
    private bool isModalVisible = false;
    private bool isEdit = false;
    private Validations? validations;
    private DataGrid<Proposal>? dataGrid;

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private IJSRuntime jsRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadProposals();
    }

    private async Task LoadProposals()
    {
        proposals = await PurchaseService.GetAllProposals();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        proposalModel = new Proposal
        {
            DateCreation = DateTime.Now,
            Status = ErpStatus.InProgress,
            Priority = Priorities.Medium,
            Number = GenerateProposalNumber()
        };
        isEdit = false;
        isModalVisible = true;
    }

    private async void ShowEditModal(Proposal proposal)
    {
        proposalModel = await PurchaseService.GetById(proposal.ID); 
        if (proposalModel != null)
        {
            isEdit = true;
            isModalVisible = true;
        }
    }

    private void ViewProposal(int id)
    {
        // Переход на страницу просмотра заявки с материалами
        NavigationManager.NavigateTo($"/proposal-view/{id}");
    }

    private void ViewProposalMaterials(int proposalId)
    {
        Console.WriteLine($"Navigating to materials for proposal: {proposalId}");
        Console.WriteLine($"URL will be: /proposal-material/{proposalId}");
        NavigationManager.NavigateTo($"/proposal-material/{proposalId}", forceLoad: true);
    }

    private async Task SaveProposal()
    {
        if (await validations!.ValidateAll())
        {
            if (isEdit)
                await PurchaseService.Update(proposalModel);
            else
                await PurchaseService.Create(proposalModel);

            CloseModal();
            await LoadProposals();
        }
    }

    private async Task DeleteProposal(int id)
    {
        if (await jsRuntime.InvokeAsync<bool>("confirm", "Вы уверены, что хотите удалить эту заявку?"))
        {
            await PurchaseService.Delete(id);
            await LoadProposals();
        }
    }

    private void CloseModal()
    {
        isModalVisible = false;
        validations?.ClearAll();
    }

    private string GenerateProposalNumber()
    {
        var year = DateTime.Now.Year;
        var count = proposals.Count + 1;
        return $"З-{year}-{count:D4}";
    }

    private Color GetStatusColor(ErpStatus status)
    {
        return status switch
        {
            ErpStatus.InProgress => Color.Warning,
            ErpStatus.Approved => Color.Success,
            ErpStatus.Rejected => Color.Danger,
            _ => Color.Secondary
        };
    }

    private Color GetPriorityColor(Priorities priority)
    {
        return priority switch
        {
            Priorities.Low => Color.Success,
            Priorities.Medium => Color.Warning,
            Priorities.High => Color.Danger,
            Priorities.Critical => Color.Dark,
            _ => Color.Secondary
        };
    }

    private string GetPriorityName(Priorities priority)
    {
        return priority switch
        {
            Priorities.Low => "Низкий",
            Priorities.Medium => "Средний", 
            Priorities.High => "Высокий",
            Priorities.Critical => "Критический",
            _ => priority.ToString()
        };
    }
}