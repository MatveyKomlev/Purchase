@page "/proposal-catalog"
@using Purchase.Data
@using Purchase.Services
@using Blazorise.DataGrid
@using Blazorise
@using Microsoft.JSInterop
@inject IProposalCatalogService CatalogService
@inject SimpleAuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Справочник материалов</PageTitle>

<h1>Справочник материалов</h1>

<Bar Breakpoint="Breakpoint.Desktop" Background="Background.Light" ThemeContrast="ThemeContrast.Light">
    <BarBrand>Управление справочником</BarBrand>
    <BarMenu>
        <BarStart>
            <BarItem>
                <Field>
                    <FieldLabel>Поиск:</FieldLabel>
                    <TextEdit @bind-Text="searchTerm" Placeholder="Поиск по названию или артикулу..."
                              Changed="@OnSearchChanged" />
                </Field>
            </BarItem>
        </BarStart>
        <BarEnd>
            <BarItem>
                <Button Color="Color.Primary" Clicked="@(() => ShowCreateModal())">
                    ➕ Добавить материал
                </Button>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

<Card Class="mb-3">
    <CardBody>
        <div class="row text-center">
            <div class="col">
                <h5 class="text-primary">@totalItems</h5>
                <small class="text-muted">Всего материалов</small>
            </div>
            <div class="col">
                <h5 class="text-success">@uniqueCategories</h5>
                <small class="text-muted">Уникальных категорий</small>
            </div>
            <div class="col">
                <h5 class="text-warning">@materialsWithManufacturer</h5>
                <small class="text-muted">С указанием производителя</small>
            </div>
            <div class="col">
                <h5 class="text-info">@totalUsage</h5>
                <small class="text-muted">Использований в заявках</small>
            </div>
        </div>
    </CardBody>
</Card>

@if (isLoading)
{
    <Card Class="mt-3">
        <CardBody Class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <span class="ms-2">Загрузка каталога...</span>
        </CardBody>
    </Card>
}
else if (!filteredCatalogItems.Any())
{
    <Card Class="mt-3">
        <CardBody Class="text-center">
            <div class="text-muted mb-3" style="font-size: 3rem;">📦</div>
            <h5>Материалы не найдены</h5>
            <p class="text-muted">@(string.IsNullOrEmpty(searchTerm) ? "Добавьте первый материал в каталог" : "По вашему запросу ничего не найдено")</p>
            @if (string.IsNullOrEmpty(searchTerm))
            {
                <Button Color="Color.Primary" Clicked="@(() => ShowCreateModal())">
                    ➕ Добавить материал
                </Button>
            }
        </CardBody>
    </Card>
}
else
{
    <Card Class="mt-3">
        <CardBody>
            <DataGrid TItem="ProposalCatalog"
                      Data="@filteredCatalogItems"
                      @ref="dataGrid"
                      Editable="false"
                      ShowPager="true"
                      PageSize="10"
                      Responsive="true"
                      Class="table-striped">
                <DataGridColumns>
                    <DataGridColumn TItem="ProposalCatalog" Field="@nameof(ProposalCatalog.ID)" Caption="ID" Sortable="true" Width="80px" />

                    <DataGridColumn TItem="ProposalCatalog" Field="@nameof(ProposalCatalog.Material)" Caption="Материал" Sortable="true" Filterable="true">
                        <DisplayTemplate>
                            <div>
                                <strong>@context.Material</strong>
                                @if (!string.IsNullOrEmpty(context.ManufacturerPartNumber))
                                {
                                    <br />
                                    <small class="text-muted">Артикул: @context.ManufacturerPartNumber</small>
                                }
                            </div>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalCatalog" Field="@nameof(ProposalCatalog.Category)" Caption="Категория" Sortable="true" Filterable="true" Width="150px">
                        <DisplayTemplate>
                            <Badge Color="Color.Info" Class="text-uppercase">
                                @context.Category
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalCatalog" Field="@nameof(ProposalCatalog.Price)" Caption="Цена" Sortable="true" TextAlignment="TextAlignment.End" Width="120px">
                        <DisplayTemplate>
                            <strong class="text-success">@context.Price.ToString("C0")</strong>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalCatalog" Caption="Производитель" Sortable="true" Filterable="true">
                        <DisplayTemplate>
                            @if (!string.IsNullOrEmpty(context.ManufacturerName))
                            {
                                <div>
                                    <strong>@context.ManufacturerName</strong>
                                    @if (!string.IsNullOrEmpty(context.ManufacturerPartNumber))
                                    {
                                        <br />
                                        <small class="text-muted">@context.ManufacturerPartNumber</small>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalCatalog" Field="@nameof(ProposalCatalog.UnitOfMeasure)" Caption="Ед. изм." Sortable="true" TextAlignment="TextAlignment.Center" Width="100px">
                        <DisplayTemplate>
                            <Badge Color="Color.Secondary">
                                @(string.IsNullOrEmpty(context.UnitOfMeasure) ? "—" : context.UnitOfMeasure)
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TItem="ProposalCatalog" Caption="Использование" Sortable="true" TextAlignment="TextAlignment.Center" Width="120px">
                        <DisplayTemplate>
                            @{
                                var usageCount = context.ProposalMaterials?.Count ?? 0;
                            }
                            @if (usageCount > 0)
                            {
                                <span title="@($"Используется в {usageCount} заявках")">
                                    <Badge Color="Color.Success">
                                        @usageCount
                                    </Badge>
                                </span>
                            }
                            else
                            {
                                <Badge Color="Color.Light" Class="text-dark">0</Badge>
                            }
                        </DisplayTemplate>
                    </DataGridColumn>

                    <DataGridColumn TextAlignment="TextAlignment.Center" Filterable="false" Sortable="false" Caption="Действия" Width="180px">
                        <DisplayTemplate>
                            @{
                                var catalogItem = (ProposalCatalog)context;
                                var canDelete = (catalogItem.ProposalMaterials?.Count ?? 0) == 0;
                            }
                            <div class="btn-group btn-group-sm">
                                <Button Color="Color.Warning"
                                        Size="Size.Small"
                                        Clicked="@(async () => await ShowEditModal(catalogItem))"
                                        Title="Редактировать">
                                    ✏️
                                </Button>

                                <Button Color="Color.Danger"
                                        Size="Size.Small"
                                        Hidden="@(!canDelete)"
                                        Clicked="@(async () => await DeleteItem(catalogItem.ID))"
                                        Title="Удалить">
                                    🗑️
                                </Button>

                                <Button Color="Color.Secondary"
                                        Size="Size.Small"
                                        Hidden="@canDelete"
                                        Title="Нельзя удалить - используется в заявках"
                                        Disabled="true">
                                    ⚠️
                                </Button>
                            </div>
                        </DisplayTemplate>
                    </DataGridColumn>
                </DataGridColumns>
            </DataGrid>
        </CardBody>
    </Card>
}

<Modal @bind-Visible="isModalVisible" Size="ModalSize.Large">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@(isEdit ? "Редактировать материал" : "Добавить материал")</ModalTitle>
            <Button Close Clicked="@(() => CloseModal())" />
        </ModalHeader>
        <ModalBody>
            <Validations @ref="validations" Model="@catalogModel" ValidateOnLoad="false">
                <div class="row">
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Материал *</FieldLabel>
                            <TextEdit @bind-Text="@catalogModel.Material"
                                      Placeholder="Название материала">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </div>
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Категория *</FieldLabel>
                            <TextEdit @bind-Text="@catalogModel.Category"
                                      Placeholder="Категория материала">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Производитель</FieldLabel>
                            <TextEdit @bind-Text="@catalogModel.ManufacturerName"
                                      Placeholder="Название производителя" />
                        </Field>
                    </div>
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Партномер</FieldLabel>
                            <TextEdit @bind-Text="@catalogModel.ManufacturerPartNumber"
                                      Placeholder="Партномер производителя" />
                        </Field>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Единица измерения</FieldLabel>
                            <div class="input-group">
                                <TextEdit @bind-Text="@catalogModel.UnitOfMeasure"
                                          Placeholder="Выберите единицу измерения" />
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => SelectUnitOfMeasure(""))">— Выберите —</button></li>
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => SelectUnitOfMeasure("шт"))">Штуки (шт)</button></li>
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => SelectUnitOfMeasure("кг"))">Килограммы (кг)</button></li>
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => SelectUnitOfMeasure("м"))">Метры (м)</button></li>
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => SelectUnitOfMeasure("л"))">Литры (л)</button></li>
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => SelectUnitOfMeasure("уп"))">Упаковки (уп)</button></li>
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => SelectUnitOfMeasure("компл"))">Комплекты (компл)</button></li>
                                </ul>
                            </div>
                        </Field>
                    </div>
                    <div class="col-md-6">
                        <Field>
                            <FieldLabel>Цена *</FieldLabel>
                            <NumericEdit TValue="int"
                                         @bind-Value="@catalogModel.Price"
                                         Min="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </NumericEdit>
                        </Field>
                    </div>
                </div>

                @if (isEdit)
                {
                    <Field>
                        <FieldLabel>Использование в заявках</FieldLabel>
                        <div class="form-control-plaintext">
                            @if ((catalogModel.ProposalMaterials?.Count ?? 0) > 0)
                            {
                                <Badge Color="Color.Info">
                                    Используется в @catalogModel.ProposalMaterials.Count заявках
                                </Badge>
                            }
                            else
                            {
                                <span class="text-muted">Не используется</span>
                            }
                        </div>
                    </Field>
                }
            </Validations>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary"
                    Clicked="@(async () => await SaveItem())"
                    Disabled="@isSaving">
                @if (isSaving)
                {
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                }
                💾 @(isEdit ? "Обновить" : "Создать")
            </Button>
            <Button Color="Color.Secondary"
                    Clicked="@(() => CloseModal())"
                    Disabled="@isSaving">
                ❌ Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private List<ProposalCatalog> catalogItems = new();
    private List<ProposalCatalog> filteredCatalogItems = new();
    private ProposalCatalog catalogModel = new();
    private string searchTerm = "";
    private bool isModalVisible = false;
    private bool isEdit = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private Validations? validations;
    private DataGrid<ProposalCatalog>? dataGrid;

    private int totalItems = 0;
    private int uniqueCategories = 0;
    private int materialsWithManufacturer = 0;
    private int totalUsage = 0;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isAuth = await AuthService.IsAuthenticatedAsync();
            if (!isAuth)
            {
                NavigationManager.NavigateTo("/simple-login");
                return;
            }

            await LoadCatalog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки каталога: {ex.Message}";
            Console.WriteLine($"❌ Ошибка загрузки каталога: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(errorMessage))
        {
            await ShowError(errorMessage);
            errorMessage = "";
        }
    }

    private async Task LoadCatalog()
    {
        catalogItems = await CatalogService.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredCatalogItems = catalogItems;
        }
        else
        {
            var term = searchTerm.ToLower();
            filteredCatalogItems = catalogItems
                .Where(c => c.Material.ToLower().Contains(term) ||
                           c.Category.ToLower().Contains(term) ||
                           (c.ManufacturerPartNumber ?? "").ToLower().Contains(term) ||
                           (c.ManufacturerName ?? "").ToLower().Contains(term))
                .ToList();
        }
        CalculateStatistics();
    }

    private void CalculateStatistics()
    {
        totalItems = filteredCatalogItems.Count;
        uniqueCategories = filteredCatalogItems.Select(c => c.Category).Distinct().Count();
        materialsWithManufacturer = filteredCatalogItems.Count(c => !string.IsNullOrEmpty(c.ManufacturerName));
        totalUsage = filteredCatalogItems.Sum(c => c.ProposalMaterials?.Count ?? 0);
    }

    private void SelectUnitOfMeasure(string unit)
    {
        catalogModel.UnitOfMeasure = unit;
        StateHasChanged();
    }

    private void OnSearchChanged(string? value)
    {
        ApplyFilter();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        catalogModel = new ProposalCatalog
        {
            UnitOfMeasure = "шт",
            Price = 0
        };
        isEdit = false;
        isModalVisible = true;
        StateHasChanged();
    }

    private async Task ShowEditModal(ProposalCatalog item)
    {
        try
        {
            var catalog = await CatalogService.GetByIdAsync(item.ID);
            if (catalog != null)
            {
                catalogModel = catalog;
                isEdit = true;
                isModalVisible = true;
                StateHasChanged();
            }
            else
            {
                await ShowError("Материал не найден!");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка загрузки материала: {ex.Message}");
        }
    }

    private async Task SaveItem()
    {
        if (validations == null) return;

        try
        {
            isSaving = true;
            StateHasChanged();

            if (await validations.ValidateAll())
            {
                if (isEdit)
                {
                    await CatalogService.UpdateAsync(catalogModel);
                    await ShowSuccess("Материал успешно обновлен!");
                }
                else
                {
                    await CatalogService.CreateAsync(catalogModel);
                    await ShowSuccess("Материал успешно создан!");
                }

                CloseModal();
                await LoadCatalog();
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка сохранения: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteItem(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
                "Вы уверены, что хотите удалить этот материал из каталога?");

            if (confirmed)
            {
                await CatalogService.DeleteAsync(id);
                await ShowSuccess("Материал успешно удален!");
                await LoadCatalog();
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Ошибка удаления: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        isModalVisible = false;
        isSaving = false;
        validations?.ClearAll();
        StateHasChanged();
    }

    private async Task ShowSuccess(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"✅ {message}");
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"❌ {message}");
    }
}